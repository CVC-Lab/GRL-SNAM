# cars.ari: the panels around cars.py, which drives N Ackermann cars with YOUR controller.
#
#   python cars.py                     # or: grl-snam ariadne cars
#
# The document holds the panels and the look, and cars.py does the rest:
# - Run: the plant, the world, how many cars, the controller (yours or libcvc's navigator), ticks
#   per frame, pause, the camera, and New goals / Reset, which call back into cars.py.
#   The plant is cars.py's choice (its Cars object); this combo only asks cars.py for one.
# - Controller: YOUR PARAMETERS. Each slider writes ctl.<name>, and cars.py hands it to
#   controller() as p["<name>"] every tick. To add one, add a slider bound to ctl.<name> here and
#   "<name>": <start value> to PARAMS in cars.py.
# - Cars: the run's numbers (arrivals: goals reached, each car then getting a new one), a row
#   per car (cars.py writes the `carrows` table), the chosen car's speed and the closest two
#   cars' gap as plots.
# - the scene: the ground, the buildings and the cars under a soft afternoon light.

meta:
  name: Cars (your controller)
  min_libcvc: 3.4.0

init: |
  (begin
    (state-set "run.paused" "0")
    (state-set "view.camera" "overview")
    (state-set "view.car" "0"))

menubar:
  - menu: Run
    items:
      - menu_item: Paused
        bind: run.paused
      - menu_item: New goals
        on: new_goals
      - menu_item: Reset
        on: reset
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Run
    id: run
    pos: [16, 30]
    size: [340, 300]
    children:
      - combo: Plant
        bind: run.plant
        options: [Kinematic bicycle, Jolt RoboRacers, Jolt Humvees, Jolt mixed, Dynamic RoboRacers]
        values: ["kinematic:roboracer", "jolt:roboracer", "jolt:humvee", "jolt:roboracer,humvee",
                 "dynamic:roboracer"]
      - combo: World
        bind: run.world
        options: [Flat ground, Block city, Austin]
        values: [flat, blocks, austin]
      - slider_int: Cars
        bind: run.cars
        lo: 1
        hi: 24
      - combo: Controller
        bind: run.controller
        options: [Yours (cars.py), libcvc's navigator]
        values: [yours, navigator]
      - slider_int: Ticks per frame
        bind: run.ticks
        lo: 1
        hi: 8
      - checkbox: New goal on arrival
        bind: run.regoal
      - checkbox: Paused
        bind: run.paused
      - combo: Camera
        bind: view.camera
        options: [Overview, Follow the chosen car]
        values: [overview, follow]
      - button: New goals
        on: new_goals
      - button: Reset
        on: reset

  - window: Controller
    id: controller
    pos: [16, 342]
    size: [340, 170]
    children:
      - text: "your parameters (ctl.*)"
      - slider_float: Speed (x top speed)
        bind: ctl.speed
        lo: 0.05
        hi: 1.0
        fmt: "%.2f"
      - slider_float: Spacing (car lengths)
        bind: ctl.spacing
        lo: 0.0
        hi: 10.0
        fmt: "%.1f"
      - slider_float: Steering gain
        bind: ctl.gain
        lo: 0.1
        hi: 5.0
        fmt: "%.2f"
      - slider_float: Wall look-ahead (car lengths)
        bind: ctl.look
        lo: 0.5
        hi: 12.0
        fmt: "%.1f"

  - window: Cars
    id: cars
    pos: [368, 30]
    size: [400, 470]
    children:
      - text: "plant"
        bind: stats.plant
      - text: "world"
        bind: stats.world
      - text: "commands via"
        bind: stats.backend
      - text: "time (s)"
        bind: stats.time
      - text: "at their goals"
        bind: stats.arrived
      - text: "arrivals"
        bind: stats.arrivals
      - text: "car-ticks touching"
        bind: stats.touching
      - text: ""
        bind: stats.note
      - separator
      - slider_int: Chosen car
        bind: view.car
        lo: 0
        hi: 23
      - plot: Chosen car's speed (m/s)
        bind: plot.speed
        height: 50
      - plot: Closest gap between two cars (m)
        bind: plot.gap
        height: 50
      - separator
      - type: group
        layout: { kind: grid, col_widths: [36, 64, 56, 64, 72, 80] }
        children:
          - text: "car"
          - text: "m/s"
          - text: "steer"
          - text: "accel"
          - text: "to goal"
          - text: ""
      - type: group
        repeat: (state-get "carrows")
        layout: { kind: grid, col_widths: [36, 64, 56, 64, 72, 80] }
        children:
          - text: ""
            bind: carrows.{i}.car
          - text: ""
            bind: carrows.{i}.speed
          - text: ""
            bind: carrows.{i}.steer
          - text: ""
            bind: carrows.{i}.accel
          - text: ""
            bind: carrows.{i}.goal
          - text: ""
            bind: carrows.{i}.status

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 20, max_radius: 600, per_distance: 3, lead: 0.5,
             lift: 10, ground: world }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 5], radius: 400 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
  nodes:
    # Austin (World: Austin): cars.py loads the scene bundle into the data store at data.city,
    # and this node draws it, the terrain with its aerial image draped and the buildings. Hidden
    # on the other worlds, which cars.py draws itself.
    - node: city
      source: { data: city }
      visible: { bind: view.city, default: false }
