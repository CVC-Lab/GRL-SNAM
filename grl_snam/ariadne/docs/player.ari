# player.ari — a recorded GRL-SNAM run, replayed in an Ariadne document. grl_snam/ariadne/fog.py and
# squad.py run it: they load the recorded traces, draw them into this document's scene at the
# play head every frame, and write the readouts; this document is the transport around them.
#
#   python -m grl_snam.ariadne fog ghost
#   python -m grl_snam.ariadne squad convoy
#
# - Transport: play / pause, speed, loop, and a position slider (play.pos, 0..1) the port moves as
#   it plays; drag it to scrub.
# - Caption: the recording's caption at the play head (play.caption).
# - Agents: one row per agent (agents, a table: key, speed, goal distance, mode), and the
#   first agent's HUD lines (nav.hud).
# - The scene: what the port draws, under a soft afternoon light.

meta:
  name: GRL-SNAM player
  min_libcvc: 3.4.0

init: |
  (begin
    (state-set "play.playing" "1")
    (state-set "play.speed" "1.0")
    (state-set "play.loop" "1")
    (state-set "play.pos" "0")
    (state-set "view.camera" "overview"))

menubar:
  - menu: Player
    items:
      - menu_item: Playing
        bind: play.playing
      - menu_item: Loop
        bind: play.loop
      - menu_item: Restart
        on: restart
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Player
    id: player
    pos: [16, 30]
    size: [360, 190]
    children:
      - text: ""
        bind: play.title
      - slider_float: Position
        bind: play.pos
        lo: 0
        hi: 1
        fmt: "%.3f"
      - text: "time"
        bind: play.time
      - checkbox: Playing
        bind: play.playing
      - slider_float: Speed
        bind: play.speed
        lo: 0.1
        hi: 8.0
        fmt: "%.1fx"
      - checkbox: Loop
        bind: play.loop
      - combo: Camera
        bind: view.camera
        options: [Overview, Follow the first agent]
        values: [overview, follow]

  - window: Caption
    id: caption
    pos: [392, 30]
    size: [520, 60]
    children:
      - text: ""
        bind: play.caption

  - window: Agents
    id: agents
    pos: [16, 232]
    size: [360, 330]
    children:
      - type: group
        layout: { kind: grid, col_widths: [60, 90, 110, 70] }
        children:
          - text: "agent"
          - text: "speed m/s"
          - text: "to goal m"
          - text: "mode"
      - type: group
        repeat: (state-get "agents")
        layout: { kind: grid, col_widths: [60, 90, 110, 70] }
        children:
          - text: ""
            bind: agents.{i}.key
          - text: ""
            bind: agents.{i}.speed
          - text: ""
            bind: agents.{i}.goal
          - text: ""
            bind: agents.{i}.mode
      - separator
      - type: group
        repeat: (state-get "nav.hud")
        children:
          - text: ""
            bind: nav.hud.{i}

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 60, max_radius: 700, per_distance: 3, lead: 0.5,
             lift: 20, ground: world }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 900 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
