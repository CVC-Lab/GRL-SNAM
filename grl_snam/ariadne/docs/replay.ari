# replay.ari — a recorded `live --arms` run (a run log, grl_snam.run_log/v1) played back.
# grl_snam/ariadne/replay.py reads the log, draws each arm's ghost where it was at the play head,
# and writes the Stats and Ledger windows there; this document is the window around it:
#
#   python -m grl_snam.ariadne live austin-freedrive --plant kinematic --arms trained,untrained,constant --log run.npz
#   python -m grl_snam.ariadne replay run.npz
#
# - Transport: libcvc's sim_transport component (cvc://components/sim_transport.ari): Paused
#   (sim.paused), Speed (sim.speed), Step (one tick on, while paused) and Restart; beside it the
#   Replay window: the run, a Position slider (play.pos, 0..1) that scrubs, the time, Loop and the
#   camera.
# - Stats and Ledger: stats_panels.ari's windows, as the live run showed them at that tick. Their
#   charts draw the whole run with a cursor at the play head (play.t); a click on one seeks there.
# - The scene: the recorded world (the city this document names, a generated world, or the flat
#   square), the start, the goal, and every arm's ghost and track.

meta:
  name: GRL-SNAM replay
  min_libcvc: 3.7.11

import:
  - {uri: cvc://components/sim_transport.ari, optional: true}
  - stats_panels.ari

requires:
  - {name: chart, optional: true}   # the Stats and Ledger charts (libcvc 3.7.14)

units:
  sim_transport:                    # where the host has no libcvc component library
    fallback: true
    window: Simulation
    id: sim_transport
    children:
      - checkbox: Paused
        bind: sim.paused
      - slider_float: Speed
        bind: sim.speed
        lo: 0.0
        hi: 4.0
        fmt: "%.2f"
      - button: Step
        on: sim.step
      - button: Restart
        on: sim.restart

data:
  city:
    uri: cvcpkg://cy-pca/scene-austin-south-small
    path: share/cvc-scenes/austin_south
    as: city_bundle
    load: lazy

init: |
  (begin
    (state-set "sim.paused" "0")
    (state-set "sim.speed" "1.0")
    (state-set "play.pos" "0")
    (state-set "play.loop" "0")
    (state-set "view.camera" "follow")
    (state-set "arms.on" "1")
    (state-set "arms.live" "0")
    (state-set "ledger.book" "dU")
    (state-set "run.world" "data")
    (state-set "run.uri" "cvcpkg://cy-pca/scene-austin-south-small")
    (state-set "run.data_path" "share/cvc-scenes/austin_south")
    (state-set "run.crop" "600"))

menubar:
  - menu: Replay
    items:
      - menu_item: Paused
        bind: sim.paused
      - menu_item: Loop
        bind: play.loop
      - menu_item: Restart
        on: sim.restart
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Replay
    id: replay
    pos: [16, 30]
    size: [420, 250]
    children:
      - text: ""
        bind: replay.title
      - text: ""
        bind: replay.made
      - slider_float: Position
        bind: play.pos
        lo: 0
        hi: 1
        fmt: "%.3f"
      - text: ""
        bind: play.time
      - checkbox: Loop
        bind: play.loop
      - combo: Camera
        bind: view.camera
        options: [Follow the arm, Orbit]
        values: [follow, orbit]
        tooltip: "the Stats window's Follow picks the arm"

  - include: sim_transport
    pos: [16, 292]
    size: [260, 170]

  - include: arms_stats
    pos: [1172, 30]
    size: [600, 400]

  - include: arms_ledger
    pos: [1172, 442]
    size: [600, 540]

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 60, max_radius: 600, per_distance: 3, lead: 0.5,
             lift: 20, ground: city }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 900 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
  nodes:
    - node: city
      source: { data: city }     # the terrain (aerial image draped) and the buildings, when loaded
      visible: { bind: view.city, default: true }
    - node: gen                  # World: Generated (austin-freedrive): libcvc's generator
      type: generated_world
      look: soft
      visible: { bind: view.generated, default: false }
