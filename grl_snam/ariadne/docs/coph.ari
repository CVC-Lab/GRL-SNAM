# coph.ari — CoPH-Stagewise's crossing and hazard episodes in 3-D (demo 2a). grl_snam/ariadne/coph.py
# runs them live (the vendored runner, as `grl-snam coph` does) or replays a `grl-snam coph` run,
# draws both arms side by side into this document's scene, and writes the readouts.
#
#   python -m grl_snam.ariadne coph crossing
#   python -m grl_snam.ariadne coph hazard --scene severe
#   python -m grl_snam.ariadne coph crossing --from runs/crossing
#   python -m grl_snam.ariadne coph walkthrough --from runs/coph
#
# The windows are docked so that the floors stay clear: CoPH and Learning down the right edge
# (a pos past the view's edge opens the window against it), Headline above and Agents below, in
# fractions of the view that coph.py's RIGHT, TOP and BOTTOM repeat for the camera.
# - CoPH: play / pause, speed, loop, a position slider (play.pos, 0..1), Live (play.live) while a
#   live run is still going, the heat map, the camera, and the walkthrough's caption and buttons
#   when coph.py runs one (--tour).
# - Headline: the claims as the roadmap's §8 labels them: what the reference established, with its
#   own seed counts (green); this run's number once both arms finish; what it has not established
#   (amber); and that the validation gate cannot reject at its slack, with this run's count.
# - Agents: one row per agent per arm: its learner, its packet bytes and its energy ledger.
# - Learning (pycvc_gl's chart:, libcvc 3.7.14; hidden without it): for one agent, what each
#   arm's learner measured at each update. The held-out field loss before and after it, which
#   the gate compares, with the gate's threshold; below, a statistic Show picks. A click on
#   either chart seeks there.

meta:
  name: GRL-SNAM CoPH
  min_libcvc: 3.4.0

requires:
  - {name: chart, optional: true}   # the Learning window (libcvc 3.7.14)

init: |
  (begin
    (state-set "play.playing" "1")
    (state-set "play.speed" "1.0")
    (state-set "play.loop" "0")
    (state-set "play.live" "1")
    (state-set "play.pos" "0")
    (state-set "view.heat" "truth")
    (state-set "view.camera" "overview")
    (state-set "view.learning" "1")
    (state-set "view.tour" "0")
    (state-set "tour.step" "")
    (state-set "tour.caption" "")
    (state-set "learn.agent" "0")
    (state-set "learn.show" "field")
    (state-set "learn.log" "0")
    (state-set "learn.t" "0"))

menubar:
  - menu: CoPH
    items:
      - menu_item: Playing
        bind: play.playing
      - menu_item: Live
        bind: play.live
      - menu_item: Loop
        bind: play.loop
      - menu_item: Restart
        on: restart
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: CoPH
    id: transport
    pos: [10000, 4]
    size: ["27%", "41%"]
    children:
      - text: ""
        bind: play.title
      - slider_float: Position
        bind: play.pos
        lo: 0
        hi: 1
        fmt: "%.3f"
      - text: "time"
        bind: play.time
      - type: group
        layout: { kind: grid, col_widths: [100, 110, 90] }
        children:
          - checkbox: Playing
            bind: play.playing
          - checkbox: Live
            bind: play.live
          - checkbox: Loop
            bind: play.loop
      - slider_float: Speed
        bind: play.speed
        lo: 0.1
        hi: 8.0
        fmt: "%.1fx"
      - combo: Heat map
        bind: view.heat
        options: [True risk field, Agent 0's own r, Agent 1's own r]
        values: [truth, agent0, agent1]
      - combo: Camera
        bind: view.camera
        options: [Overview, Follow agent 0 (right)]
        values: [overview, follow]
      - checkbox: Learning panels
        bind: view.learning
        visible_when: (has? "chart")
      - separator
      - type: group
        layout: { kind: grid, col_widths: [130, 170] }
        visible_when: (not (= (state-get "tour.step") ""))
        children:
          - checkbox: Walkthrough
            bind: view.tour
          - text: ""
            bind: tour.step
            color: [0.65, 0.68, 0.72]
      - type: group
        layout: { kind: grid, col_widths: [80, 80, 80] }
        visible_when: (not (= (state-get "tour.step") ""))
        children:
          - button: Back
            on: tour_back
          - button: Next
            on: tour_next
          - button: Restart
            on: tour_restart

  - window: Headline
    id: headline
    pos: [4, 4]
    size: ["72.5%", "28%"]
    children:
      - text: ""
        bind: tour.caption
        color: [1.0, 0.95, 0.72]
        visible_when: (= (state-get "view.tour") "1")
      - text: ""
        bind: coph.headline
        visible_when: (not (= (state-get "view.tour") "1"))
      - text: ""
        bind: coph.reference
        color: [0.45, 0.86, 0.52]
      - text: ""
        bind: coph.result
      - text: ""
        bind: coph.unestablished
        color: [0.98, 0.72, 0.30]
      - text: ""
        bind: coph.gate
        color: [0.98, 0.72, 0.30]
      - text: ""
        bind: coph.status
        color: [0.65, 0.68, 0.72]

  - window: Learning
    id: learning
    pos: [10000, 10000]
    size: ["27%", "58%"]
    visible_when: (and (has? "chart") (= (state-get "view.learning") "1"))
    children:
      - text: ""
        bind: learn.caption
      - combo: Agent
        bind: learn.agent
        options: [Agent 0, Agent 1]
        values: ["0", "1"]
      - chart: Held-out field loss, each update
        bind: learn.heldout
        log_y: true
        legend: top
        x_label: time (s)
        cursor: learn.t
        pick: learn.pick
        on: learn_seek
        height: 112
      - combo: Show
        bind: learn.show
        options: [Own field against the truth, Damping against the world's,
                  "Policy pi (from replay: unestablished)", Held-out plant loss,
                  "Replay cost (unestablished)"]
        values: [field, damping, policy, plant, replay]
      - text: ""
        bind: learn.note
      - chart: The chosen statistic
        bind: learn.stat
        log_y: learn.log
        legend: top
        x_label: time (s)
        cursor: learn.t
        pick: learn.pick
        on: learn_seek
        height: 112

  - window: Agents
    id: agents
    pos: [4, 10000]
    size: ["72.5%", "22%"]
    children:
      - text: "learner (version, pi, damping, accepts / rejects, last reason); payload bytes; energy ledger (J, unit mass): work, heat, dKE, shaping, residual"
      - type: group
        layout: { kind: grid, col_widths: [64, 76, 62, 34, 48, 48, 46, 58, 82, 66, 66, 56, 56, 50, 60, 72] }
        children:
          - text: "arm"
          - text: "agent"
          - text: "status"
          - text: "ver"
          - text: "pi r*"
          - text: "pi b*"
          - text: "d"
          - text: "acc/rej"
          - text: "last"
          - text: "sent B"
          - text: "recv B*"
          - text: "work"
          - text: "heat"
          - text: "dKE"
          - text: "shaping"
          - text: "residual"
      - type: group
        repeat: (state-get "agents")
        layout: { kind: grid, col_widths: [64, 76, 62, 34, 48, 48, 46, 58, 82, 66, 66, 56, 56, 50, 60, 72] }
        children:
          - text: ""
            bind: agents.{i}.arm
          - text: ""
            bind: agents.{i}.agent
          - text: ""
            bind: agents.{i}.status
          - text: ""
            bind: agents.{i}.version
          - text: ""
            bind: agents.{i}.pi_risk
          - text: ""
            bind: agents.{i}.pi_barrier
          - text: ""
            bind: agents.{i}.damping
          - text: ""
            bind: agents.{i}.decisions
          - text: ""
            bind: agents.{i}.reason
          - text: ""
            bind: agents.{i}.sent
          - text: ""
            bind: agents.{i}.received
          - text: ""
            bind: agents.{i}.work
          - text: ""
            bind: agents.{i}.heat
          - text: ""
            bind: agents.{i}.dke
          - text: ""
            bind: agents.{i}.shaping
          - text: ""
            bind: agents.{i}.residual
      - text: "* pi comes from replay, and what an agent receives feeds its field fit; both run here, and the reference has not established a gain from either."
        color: [0.98, 0.72, 0.30]

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 12, max_radius: 60, per_distance: 3, lead: 0.5,
             lift: 4, ground: world }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [15, 4, 1], radius: 30 }
      key: { intensity: 1.3, azimuth: -60, elevation: 38, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
