# fleet.ari — a live squad of Humvees on real Austin. grl_snam/ariadne/fleet.py runs the squad
# (grl_snam.squad.Squad) and draws it; this document is the controls and readouts around it:
#
#   python -m grl_snam.ariadne fleet
#
# - Fleet: the plant (GRL-SNAM's own torch squad; or libcvc's sim_world with Jolt Humvees, the
#   dynamic single-track Humvee, or nav's kinematic bicycle), how many agents, ticks per frame, pause, New goals and Restart;
# - Agents: a row per agent (fleet.py writes the `agents` table) and the run's readouts;
# - the scene: Austin and the Humvees under a soft afternoon light.

meta:
  name: GRL-SNAM fleet
  min_libcvc: 3.4.0

init: |
  (begin
    (state-set "fleet.ticks" "2")
    (state-set "view.paused" "0")
    (state-set "view.camera" "follow"))

menubar:
  - menu: Fleet
    items:
      - menu_item: Paused
        bind: view.paused
      - menu_item: New goals
        on: shuffle
      - menu_item: Restart
        on: restart
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Fleet
    id: fleet
    pos: [16, 30]
    size: [330, 230]
    children:
      - combo: Plant
        bind: fleet.plant
        options: [Torch (GRL-SNAM), Jolt Humvees, Dynamic Humvees, Kinematic (sim_world)]
        values: [torch, "jolt:humvee", "dynamic:humvee", kinematic]
      - slider_int: Agents
        bind: fleet.agents
        lo: 1
        hi: 16
      - slider_int: Ticks per frame
        bind: fleet.ticks
        lo: 1
        hi: 8
      - checkbox: Paused
        bind: view.paused
      - combo: Camera
        bind: view.camera
        options: [Follow the first agent, Overview]
        values: [follow, overview]
      - button: New goals
        on: shuffle

  - window: Agents
    id: agents
    pos: [16, 272]
    size: [330, 330]
    children:
      - text: "plant"
        bind: stats.plant
      - text: "sim time (s)"
        bind: stats.time
      - text: "arrived"
        bind: stats.arrived
      - separator
      - type: group
        layout: { kind: grid, col_widths: [50, 80, 100, 80] }
        children:
          - text: "agent"
          - text: "speed m/s"
          - text: "to goal m"
          - text: "mode"
      - type: group
        repeat: (state-get "agents")
        layout: { kind: grid, col_widths: [50, 80, 100, 80] }
        children:
          - text: ""
            bind: agents.{i}.key
          - text: ""
            bind: agents.{i}.speed
          - text: ""
            bind: agents.{i}.goal
          - text: ""
            bind: agents.{i}.mode

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 60, max_radius: 700, per_distance: 3, lead: 0.5,
             lift: 20, ground: world }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 900 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
