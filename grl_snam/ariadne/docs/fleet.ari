# fleet.ari — a live squad of Humvees, on the plant and in the world you pick. grl_snam/ariadne/fleet.py
# runs the squad (grl_snam.squad.Squad) and draws it; this document is the controls and readouts:
#
#   python -m grl_snam.ariadne fleet
#
# The settings are the ones libcvc's multi-car template uses (pycvc_gl.cars, libcvc's docs/CARS.md),
# set here in init:, on the sliders, with --set / --params, or from Python:
#   nav_plant.vehicle  the plant: torch (GRL-SNAM's squad) or one libcvc's plant_host names
#   nav.*, nav.vehicle.*, nav_plant.*   the navigator and the plant (on the torch squad, the keys
#                      that mean the same thing there: grl_snam/ariadne/README.md)
#   run.*              the world: data (the data: block's city) | generated | flat; its URI
#   world.*            libcvc's terrain generator (World: generated)
#   fleet.*            agents, ticks per frame;  view.*  pause, camera, the chosen agent
# Settings, World, Rasters, the coefficient plots and the world choice come from pycvc_gl.cars's
# cars_panels.ari (cvc://, on the host's component path).

meta:
  name: GRL-SNAM fleet
  min_libcvc: 3.7.11

import: cvc://cars_panels.ari

data:
  city:
    uri: cvcpkg://cy-pca/scene-austin-south-small
    path: share/cvc-scenes/austin_south
    as: city_bundle
    load: lazy

init: |
  (begin
    (state-set "fleet.agents" "6")
    (state-set "fleet.ticks" "2")
    (state-set "nav_plant.vehicle" "torch")
    (state-set "run.world" "data")
    (state-set "run.uri" "cvcpkg://cy-pca/scene-austin-south-small")
    (state-set "run.data_path" "share/cvc-scenes/austin_south")
    (state-set "run.crop" "600")
    (state-set "view.paused" "0")
    (state-set "view.camera" "follow")
    (state-set "view.car" "0")
    (state-set "view.raster_m" "120")
    (state-set "world.seed" "7")
    (state-set "world.half" "500")
    (state-set "world.amp" "25")
    (state-set "world.water_level" "-4")
    (state-set "world.buildings" "160")
    (state-set "world.trees" "200")
    (state-set "world.rocks" "40")
    (state-set "world.terrain" "fbm")
    (state-set "world.city" "districts"))

menubar:
  - menu: Fleet
    items:
      - menu_item: Paused
        bind: view.paused
      - menu_item: New goals
        on: shuffle
      - menu_item: Restart
        on: restart
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Fleet
    id: fleet
    pos: [16, 30]
    size: [340, 380]
    children:
      - combo: Plant
        bind: nav_plant.vehicle
        options: [Torch squad (GRL-SNAM), Kinematic bicycle, Humvees (Jolt), RoboRacers (Jolt), Dynamic Humvees, Dynamic 4-wheel Humvees]
        values: [torch, kinematic, humvee, roboracer, "dynamic:humvee", "dynamic4w:humvee"]
        tooltip: "between libcvc's plants it switches at once (the agents keep their poses); to or from the torch squad it rebuilds"
      - include: cars_world_choice
      - slider_int: Agents
        bind: fleet.agents
        commit: release
        lo: 1
        hi: 16
      - slider_int: Ticks per frame
        bind: fleet.ticks
        lo: 1
        hi: 8
      - checkbox: Paused
        bind: view.paused
      - combo: Camera
        bind: view.camera
        options: [Follow the chosen agent, Overview]
        values: [follow, overview]
      - slider_int: Chosen agent
        bind: view.car
        lo: 0
        hi: 15
      - button: New goals
        on: shuffle

  - window: Agents
    id: agents
    pos: [16, 422]
    size: [340, 470]
    children:
      - text: "plant"
        bind: stats.plant
      - text: "world"
        bind: stats.world
      - text: "sim time (s)"
        bind: stats.time
      - text: "arrived"
        bind: stats.arrived
      - text: ""
        bind: stats.note
      - plot: Chosen agent's speed (m/s)
        bind: plot.speed
        height: 40
      - include: cars_coefficients
      - separator
      - type: group
        layout: { kind: grid, col_widths: [50, 80, 100, 80] }
        children:
          - text: "agent"
          - text: "speed m/s"
          - text: "to goal m"
          - text: "mode"
      - type: group
        repeat: (state-get "agents")
        layout: { kind: grid, col_widths: [50, 80, 100, 80] }
        children:
          - text: ""
            bind: agents.{i}.key
          - text: ""
            bind: agents.{i}.speed
          - text: ""
            bind: agents.{i}.goal
          - text: ""
            bind: agents.{i}.mode

  - include: cars_settings
    pos: [368, 30]
    size: [360, 330]

  - include: cars_world
    pos: [368, 372]
    size: [340, 330]

  - include: cars_rasters
    args: { cost: "its belief (grey: not seen yet)" }
    pos: [740, 30]
    size: [420, 300]

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 60, max_radius: 700, per_distance: 3, lead: 0.5,
             lift: 20, ground: world }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 900 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
  nodes:
    # World: City. The data: block's city (or what the URI field's Load points data.city at): its
    # terrain with the aerial image draped, and its buildings.
    - node: city
      source: { data: city }
      visible: { bind: view.city, default: false }
    # World: Generated. libcvc's generator, from the world.* keys (Python makes the same world for
    # the squad and the physics).
    - node: gen
      type: generated_world
      look: soft
      visible: { bind: view.generated, default: false }
