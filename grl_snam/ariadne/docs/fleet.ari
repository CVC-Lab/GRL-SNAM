# fleet.ari — a live squad of Humvees, on the plant and in the world you pick. grl_snam/ariadne/fleet.py
# runs the squad (grl_snam.squad.Squad) and draws it; this document is the controls and readouts:
#
#   python -m grl_snam.ariadne fleet
#
# The settings are the ones libcvc's multi-car template uses (pycvc_gl.cars, libcvc's docs/CARS.md),
# set here in init:, on the sliders, with --set / --params, or from Python:
#   nav_plant.vehicle  the plant: torch (GRL-SNAM's squad) or one libcvc's plant_host names
#   nav.*, nav.vehicle.*, nav_plant.*   the navigator and the plant (on the torch squad, the keys
#                      that mean the same thing there: grl_snam/ariadne/README.md)
#   world.*            libcvc's terrain generator (the gen node's settings, which seed them)
#   nav_grid.half      the navigator's grid, cut to that many metres around the world's centre
#   fleet.*            agents, ticks per frame;  view.*  pause, camera, the chosen agent
# Settings, Rasters and the coefficient plots come from pycvc_gl.cars's cars_panels.ari (cvc://, on
# the host's component path); World is libcvc's world_source component.
#
# The world is the scene's: its nodes with `world:` (data, the data: block's city; generated,
# libcvc's terrain generator; flat, a walled square), the one on named by scene.world.source (the
# World window's Source, or --world). libcvc's world runtime runs it, and the squad's grid comes
# from it (grl_snam/ariadne/_world.py); a new source or a new generated world rebuilds the squad.

meta:
  name: GRL-SNAM fleet
  min_libcvc: 3.7.11

import: [cvc://cars_panels.ari, cvc://components/world_source.ari]

data:
  city:
    uri: cvcpkg://cy-pca/scene-austin-south-small
    path: share/cvc-scenes/austin_south
    as: city_bundle
    load: lazy

init: |
  (begin
    (state-set "fleet.agents" "6")
    (state-set "fleet.ticks" "2")
    (state-set "nav_plant.vehicle" "torch")
    (state-set "nav_grid.half" "600")
    (state-set "nav_grid.flat.cell" "2.42")
    (state-set "nav_grid.flat.half" "96.8")
    (state-set "view.paused" "0")
    (state-set "view.camera" "follow")
    (state-set "view.car" "0")
    (state-set "view.raster_m" "120"))

menubar:
  - menu: Fleet
    items:
      - menu_item: Paused
        bind: view.paused
      - menu_item: New goals
        on: shuffle
      - menu_item: Restart
        on: restart
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Fleet
    id: fleet
    pos: [16, 30]
    size: [340, 380]
    children:
      - combo: Plant
        bind: nav_plant.vehicle
        options: [Torch squad (GRL-SNAM), Kinematic bicycle, Humvees (Jolt), RoboRacers (Jolt), Dynamic Humvees, Dynamic 4-wheel Humvees]
        values: [torch, kinematic, humvee, roboracer, "dynamic:humvee", "dynamic4w:humvee"]
        tooltip: "between libcvc's plants it switches at once (the agents keep their poses); to or from the torch squad it rebuilds"
      - text: "world"
        bind: scene.world.status
      - slider_int: Agents
        bind: fleet.agents
        commit: release
        lo: 1
        hi: 16
      - slider_int: Ticks per frame
        bind: fleet.ticks
        lo: 1
        hi: 8
      - checkbox: Paused
        bind: view.paused
      - combo: Camera
        bind: view.camera
        options: [Follow the chosen agent, Overview]
        values: [follow, overview]
      - slider_int: Chosen agent
        bind: view.car
        lo: 0
        hi: 15
      - button: New goals
        on: shuffle

  - window: Agents
    id: agents
    pos: [16, 422]
    size: [340, 470]
    children:
      - text: "plant"
        bind: stats.plant
      - text: "world"
        bind: stats.world
      - text: "sim time (s)"
        bind: stats.time
      - text: "arrived"
        bind: stats.arrived
      - text: ""
        bind: stats.note
      - plot: Chosen agent's speed (m/s)
        bind: plot.speed
        height: 40
      - include: cars_coefficients
      - separator
      - type: group
        layout: { kind: grid, col_widths: [50, 80, 100, 80] }
        children:
          - text: "agent"
          - text: "speed m/s"
          - text: "to goal m"
          - text: "mode"
      - type: group
        repeat: (state-get "agents")
        layout: { kind: grid, col_widths: [50, 80, 100, 80] }
        children:
          - text: ""
            bind: agents.{i}.key
          - text: ""
            bind: agents.{i}.speed
          - text: ""
            bind: agents.{i}.goal
          - text: ""
            bind: agents.{i}.mode

  - include: cars_settings
    pos: [368, 30]
    size: [360, 330]

  - include: world_source
    pos: [368, 372]
    size: [340, 330]

  - include: cars_rasters
    args: { cost: "its belief (grey: not seen yet)" }
    pos: [740, 30]
    size: [420, 300]

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 60, max_radius: 700, per_distance: 3, lead: 0.5,
             lift: 20, ground: world }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 900 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
  physics: {}
  world: { source: data, cell: 2 }   # the world on (scene.world.source): data, generated or flat
  nodes:
    # World data: the data: block's city (or what --uri / the World window loads into data.city):
    # its terrain with the aerial image draped, and its buildings, drawn and in the physics world.
    - node: city
      source: { data: city }
      world: data
      body: {}
    # World generated: libcvc's terrain generator. The node's settings seed the world.* keys, which
    # the World window edits; Regenerate (world.request) makes a new world from them.
    - node: gen
      type: generated_world
      world: generated
      look: soft
      seed: 7
      half: 500
      amp: 25
      water_level: -4
      buildings: 160
      trees: 200
      rocks: 40
      terrain: fbm
      city: districts
      body: {}
    # World flat: a walled square 40 Humvee lengths (193.6 m) across, its grid at half a Humvee
    # (nav_grid.flat.cell; nav_grid.flat.half is half its side), as pycvc_gl.cars's flat world has it.
    - node: square
      world: flat
      source: { box: { size: [193.6, 193.6, 1] } }
      transform: { position: [0, 0, -0.5] }
      material: { color: [0.45, 0.50, 0.40] }
      body: static
    - { node: wall_s, world: flat, source: { box: { size: [193.6, 2.42, 5.808] } },
        transform: { position: [0, -95.59, 2.904] }, material: { color: [0.80, 0.78, 0.74] }, body: static }
    - { node: wall_n, world: flat, source: { box: { size: [193.6, 2.42, 5.808] } },
        transform: { position: [0, 95.59, 2.904] }, material: { color: [0.80, 0.78, 0.74] }, body: static }
    - { node: wall_w, world: flat, source: { box: { size: [2.42, 193.6, 5.808] } },
        transform: { position: [-95.59, 0, 2.904] }, material: { color: [0.80, 0.78, 0.74] }, body: static }
    - { node: wall_e, world: flat, source: { box: { size: [2.42, 193.6, 5.808] } },
        transform: { position: [95.59, 0, 2.904] }, material: { color: [0.80, 0.78, 0.74] }, body: static }
