# stats_panels.ari — the arms' windows, Stats and Ledger, as units: live.ari imports this file and
# includes them; grl_snam/ariadne/live.py (--arms) writes what they show, from
# grl_snam.ariadne._arms.ArmsRun:
#
#   import: [cvc://cars_panels.ari, stats_panels.ari]
#   windows:
#     - include: arms_stats        # pos: / size: at the include site place it (no size: it fits)
#     - include: arms_ledger
#
# Stats ends with the scene's legend (arms.legend.*, live.ghost_legend): a line per arm in its
# colour, what its cube, car and path are. replay.ari includes them too:
# grl_snam/ariadne/replay.py writes the same keys from a run log at the play head. Both show
# while arms.on is 1 (live.py sets it with --arms, replay.py always); the
# Retarget's controls only while arms.live is 1 (a live run). The charts draw a cursor at play.t
# (the replay's play head), and a click on one writes the time there to play.seek and sends
# arms_seek (the replay seeks there). The keys they bind:
#   arms_stats    arms.time; arms.stats (a table, one row per arm: arm, colour, clear_min,
#                 clear_mean, pen, path, elapsed, ms, reached); arms.goal (the next Retarget's
#                 "x, y": empty draws one) and the button, which sends arms_retarget; arms.status;
#                 view.arm (the arm the camera, the HUD and the rasters follow; arms.names lists
#                 them, one a line); the chart arms.clearance
#   arms_ledger   ledger.coef, ledger.terms, ledger.books (summed over the run), ledger.tick (this
#                 tick's): a row per arm; ledger.agent (the arm whose plant ledger and books chart
#                 show), ledger.plant (key, value, unit; n/a where the item does not apply) and
#                 ledger.plant_note; ledger.book and the charts ledger.cum, ledger.compare
#
# The charts are pycvc_gl's chart: (libcvc 3.7.14, host.set_plot). On an older host they are
# hidden, and the rows above them show the same numbers as text. The document that imports this
# file lists chart in its requires: as optional, as live.ari does.

units:
  arms_stats:
    args: { title: Stats, id: arms_stats }
    window: "{title}"
    id: "{id}"
    visible_when: (= (state-get "arms.on") "1")
    children:
      - text: "one row per arm, this leg: clearance (m), ticks penetrating, path (m),"
      - text: "elapsed (s, to the goal once there), wall time per tick (ms), reached"
      - text: ""
        bind: arms.time
      - type: group
        id: stats_table
        layout:
          kind: grid
          col_widths: [auto, auto, auto, auto, auto, auto, auto, auto, auto]
          borders: { show: all }
        children:
          - type: group
            children:
              - text: "arm"
              - separator
              - type: group
                repeat: (state-get "arms.stats")
                children:
                  - text: ""
                    bind: arms.stats.{i}.arm
          - type: group
            children:
              - text: "colour"
              - separator
              - type: group
                repeat: (state-get "arms.stats")
                children:
                  - text: ""
                    bind: arms.stats.{i}.colour
          - type: group
            children:
              - text: "min"
              - separator
              - type: group
                repeat: (state-get "arms.stats")
                children:
                  - text: ""
                    bind: arms.stats.{i}.clear_min
          - type: group
            children:
              - text: "mean"
              - separator
              - type: group
                repeat: (state-get "arms.stats")
                children:
                  - text: ""
                    bind: arms.stats.{i}.clear_mean
          - type: group
            children:
              - text: "pen"
              - separator
              - type: group
                repeat: (state-get "arms.stats")
                children:
                  - text: ""
                    bind: arms.stats.{i}.pen
          - type: group
            children:
              - text: "path"
              - separator
              - type: group
                repeat: (state-get "arms.stats")
                children:
                  - text: ""
                    bind: arms.stats.{i}.path
          - type: group
            children:
              - text: "elapsed"
              - separator
              - type: group
                repeat: (state-get "arms.stats")
                children:
                  - text: ""
                    bind: arms.stats.{i}.elapsed
          - type: group
            children:
              - text: "ms/tick"
              - separator
              - type: group
                repeat: (state-get "arms.stats")
                children:
                  - text: ""
                    bind: arms.stats.{i}.ms
          - type: group
            children:
              - text: "reached"
              - separator
              - type: group
                repeat: (state-get "arms.stats")
                children:
                  - text: ""
                    bind: arms.stats.{i}.reached
      - type: group                 # the legend (live.ghost_legend), once the ghosts are drawn
        visible_when: (!= (state-get "arms.legend.notes") "")
        children:
          - text: "in the scene:"
          - text: ""
            bind: arms.legend.slot0
            color: [0.165, 0.471, 0.839]
            visible_when: (!= (state-get "arms.legend.slot0") "")
          - text: ""
            bind: arms.legend.slot1
            color: [0.922, 0.408, 0.204]
            visible_when: (!= (state-get "arms.legend.slot1") "")
          - text: ""
            bind: arms.legend.slot2
            color: [0.106, 0.686, 0.478]
            visible_when: (!= (state-get "arms.legend.slot2") "")
          - text: ""
            bind: arms.legend.slot3
            color: [0.929, 0.631, 0.000]
            visible_when: (!= (state-get "arms.legend.slot3") "")
          - text: ""
            bind: arms.legend.slot4
            color: [0.910, 0.482, 0.643]
            visible_when: (!= (state-get "arms.legend.slot4") "")
          - text: ""
            bind: arms.legend.slot5
            color: [0.000, 0.514, 0.000]
            visible_when: (!= (state-get "arms.legend.slot5") "")
          - text: ""
            bind: arms.legend.slot6
            color: [0.384, 0.314, 0.839]
            visible_when: (!= (state-get "arms.legend.slot6") "")
          - text: ""
            bind: arms.legend.slot7
            color: [0.890, 0.286, 0.282]
            visible_when: (!= (state-get "arms.legend.slot7") "")
          - text: ""
            bind: arms.legend.notes
      - separator
      - type: group
        visible_when: (= (state-get "arms.live") "1")
        children:
          - input_text: Goal (x, y)
            bind: arms.goal
            tooltip: "where the next Retarget sends every arm (m); empty: a free point far from all of them"
          - button: Retarget every arm
            on: arms_retarget
            tooltip: "every arm's goal moves on the same tick, and a new leg starts"
      - text: ""
        bind: arms.status
      - combo: Follow
        bind: view.arm
        options: (string.split (state-get "arms.names") "\n")
        tooltip: "the arm the camera, the Navigator window and the rasters follow"
      - type: group
        visible_when: (has? "chart")
        children:
          - chart: Clearance (m), every arm
            bind: arms.clearance
            legend: right
            x_label: time (s)
            cursor: play.t
            pick: play.seek
            on: arms_seek
            height: 110

  arms_ledger:
    args: { title: Ledger, id: arms_ledger }
    window: "{title}"
    id: "{id}"
    visible_when: (= (state-get "arms.on") "1")
    children:
      - text: "per arm, this tick: the coefficients in force and the terms of U_nav"
      - type: group
        id: coef_table
        layout:
          kind: grid
          col_widths: [auto, auto, auto, auto, auto, auto, auto]
          borders: { show: all }
        children:
          - type: group
            children:
              - text: "arm"
              - separator
              - type: group
                repeat: (state-get "ledger.coef")
                children:
                  - text: ""
                    bind: ledger.coef.{i}.arm
          - type: group
            children:
              - text: "alpha"
              - separator
              - type: group
                repeat: (state-get "ledger.coef")
                children:
                  - text: ""
                    bind: ledger.coef.{i}.alpha
          - type: group
            children:
              - text: "beta"
              - separator
              - type: group
                repeat: (state-get "ledger.coef")
                children:
                  - text: ""
                    bind: ledger.coef.{i}.beta
          - type: group
            children:
              - text: "gamma"
              - separator
              - type: group
                repeat: (state-get "ledger.coef")
                children:
                  - text: ""
                    bind: ledger.coef.{i}.gamma
          - type: group
            children:
              - text: "lam_soft"
              - separator
              - type: group
                repeat: (state-get "ledger.coef")
                children:
                  - text: ""
                    bind: ledger.coef.{i}.lam_soft
          - type: group
            children:
              - text: "lam_hard"
              - separator
              - type: group
                repeat: (state-get "ledger.coef")
                children:
                  - text: ""
                    bind: ledger.coef.{i}.lam_hard
          - type: group
            children:
              - text: "mu"
              - separator
              - type: group
                repeat: (state-get "ledger.coef")
                children:
                  - text: ""
                    bind: ledger.coef.{i}.mu
      - type: group
        id: terms_table
        layout:
          kind: grid
          col_widths: [auto, auto, auto, auto, auto, auto, auto]
          borders: { show: all }
        children:
          - type: group
            children:
              - text: "arm"
              - separator
              - type: group
                repeat: (state-get "ledger.terms")
                children:
                  - text: ""
                    bind: ledger.terms.{i}.arm
          - type: group
            children:
              - text: "U"
              - separator
              - type: group
                repeat: (state-get "ledger.terms")
                children:
                  - text: ""
                    bind: ledger.terms.{i}.potential
          - type: group
            children:
              - text: "goal"
              - separator
              - type: group
                repeat: (state-get "ledger.terms")
                children:
                  - text: ""
                    bind: ledger.terms.{i}.u_goal
          - type: group
            children:
              - text: "barrier"
              - separator
              - type: group
                repeat: (state-get "ledger.terms")
                children:
                  - text: ""
                    bind: ledger.terms.{i}.u_barrier
          - type: group
            children:
              - text: "soft"
              - separator
              - type: group
                repeat: (state-get "ledger.terms")
                children:
                  - text: ""
                    bind: ledger.terms.{i}.u_soft
          - type: group
            children:
              - text: "hard"
              - separator
              - type: group
                repeat: (state-get "ledger.terms")
                children:
                  - text: ""
                    bind: ledger.terms.{i}.u_hard
          - type: group
            children:
              - text: "terrain"
              - separator
              - type: group
                repeat: (state-get "ledger.terms")
                children:
                  - text: ""
                    bind: ledger.terms.{i}.u_terrain
      - separator
      - text: "the books against U_nav (unit mass, normalized units):"
      - text: "dU = drive + projection + context + residual; dH = dKE + dU. Summed over the run:"
      - type: group
        id: books_table
        layout:
          kind: grid
          col_widths: [auto, auto, auto, auto, auto, auto, auto]
          borders: { show: all }
        children:
          - type: group
            children:
              - text: "arm"
              - separator
              - type: group
                repeat: (state-get "ledger.books")
                children:
                  - text: ""
                    bind: ledger.books.{i}.arm
          - type: group
            children:
              - text: "dU"
              - separator
              - type: group
                repeat: (state-get "ledger.books")
                children:
                  - text: ""
                    bind: ledger.books.{i}.dU
          - type: group
            children:
              - text: "drive"
              - separator
              - type: group
                repeat: (state-get "ledger.books")
                children:
                  - text: ""
                    bind: ledger.books.{i}.drive
          - type: group
            children:
              - text: "projection"
              - separator
              - type: group
                repeat: (state-get "ledger.books")
                children:
                  - text: ""
                    bind: ledger.books.{i}.projection
          - type: group
            children:
              - text: "context"
              - separator
              - type: group
                repeat: (state-get "ledger.books")
                children:
                  - text: ""
                    bind: ledger.books.{i}.context
          - type: group
            children:
              - text: "dKE"
              - separator
              - type: group
                repeat: (state-get "ledger.books")
                children:
                  - text: ""
                    bind: ledger.books.{i}.dKE
          - type: group
            children:
              - text: "residual"
              - separator
              - type: group
                repeat: (state-get "ledger.books")
                children:
                  - text: ""
                    bind: ledger.books.{i}.residual
      - text: "this tick:"
      - type: group
        id: tick_table
        layout:
          kind: grid
          col_widths: [auto, auto, auto, auto, auto, auto, auto]
          borders: { show: all }
        children:
          - type: group
            children:
              - text: "arm"
              - separator
              - type: group
                repeat: (state-get "ledger.tick")
                children:
                  - text: ""
                    bind: ledger.tick.{i}.arm
          - type: group
            children:
              - text: "dU"
              - separator
              - type: group
                repeat: (state-get "ledger.tick")
                children:
                  - text: ""
                    bind: ledger.tick.{i}.dU
          - type: group
            children:
              - text: "drive"
              - separator
              - type: group
                repeat: (state-get "ledger.tick")
                children:
                  - text: ""
                    bind: ledger.tick.{i}.drive
          - type: group
            children:
              - text: "projection"
              - separator
              - type: group
                repeat: (state-get "ledger.tick")
                children:
                  - text: ""
                    bind: ledger.tick.{i}.projection
          - type: group
            children:
              - text: "context"
              - separator
              - type: group
                repeat: (state-get "ledger.tick")
                children:
                  - text: ""
                    bind: ledger.tick.{i}.context
          - type: group
            children:
              - text: "dKE"
              - separator
              - type: group
                repeat: (state-get "ledger.tick")
                children:
                  - text: ""
                    bind: ledger.tick.{i}.dKE
          - type: group
            children:
              - text: "residual"
              - separator
              - type: group
                repeat: (state-get "ledger.tick")
                children:
                  - text: ""
                    bind: ledger.tick.{i}.residual
      - separator
      - combo: Agent
        bind: ledger.agent
        options: (string.split (state-get "arms.names") "\n")
        tooltip: "the arm whose plant ledger and cumulative books show below"
      - type: group
        visible_when: (has? "chart")
        children:
          - chart: Its books, cumulative
            bind: ledger.cum
            legend: right
            x_label: time (s)
            cursor: play.t
            pick: play.seek
            on: arms_seek
            height: 110
          - combo: Book
            bind: ledger.book
            options: [dU, drive, projection, context, dKE, residual]
          - chart: That book, cumulative, every arm
            bind: ledger.compare
            legend: right
            x_label: time (s)
            cursor: play.t
            pick: play.seek
            on: arms_seek
            height: 110
      - text: ""
        bind: ledger.plant_note
      - type: group
        id: plant_table
        layout:
          kind: grid
          col_widths: [auto, auto, auto]
          borders: { show: all }
        children:
          - type: group
            children:
              - text: "item"
              - separator
              - type: group
                repeat: (state-get "ledger.plant")
                children:
                  - text: ""
                    bind: ledger.plant.{i}.key
          - type: group
            children:
              - text: "value"
              - separator
              - type: group
                repeat: (state-get "ledger.plant")
                children:
                  - text: ""
                    bind: ledger.plant.{i}.value
          - type: group
            children:
              - text: "unit"
              - separator
              - type: group
                repeat: (state-get "ledger.plant")
                children:
                  - text: ""
                    bind: ledger.plant.{i}.unit
