# live.ari — GRL-SNAM's live demos (grl_snam.demos) in an Ariadne document. grl_snam/ariadne/live.py
# runs the demo and writes the readouts; this document is the window around it:
#
#   python -m grl_snam.ariadne live austin-freedrive
#
# - Navigator: the navigator's live NavMetrics (the network's alpha / beta / gamma, clearance, mode,
#   speed, progress), as hud.* (apart from libcvc's nav.* settings), the HUD's lines at hud.hud,
#   and the coefficients as plots;
# - View: the plant and the world (austin-freedrive takes any), pause, the sim speed, the camera;
# - Settings, World and Rasters: libcvc's multi-car template's panels (pycvc_gl.cars's
#   cars_panels.ari, by cvc:// on the host's component path), bound to libcvc's own keys:
#   nav.*, nav.vehicle.* (on GRL-SNAM's torch navigator, the keys that mean the same thing there:
#   grl_snam/ariadne/README.md), nav_plant.* (the plant: nav_plant.vehicle), run.* (the world),
#   world.* (the terrain generator);
# - the scene: the city this document names (data: below), or a generated world, and the demo's
#   vehicle, under a soft afternoon light;
# - Stats and Ledger (stats_panels.ari, beside this file): with --arms only (arms.on), one row per
#   arm, the Retarget, and each arm's coefficients, U terms, books and plant ledger, with charts
#   on a host with chart: (libcvc 3.7.14; text rows without it):
#
#   python -m grl_snam.ariadne live austin-freedrive --plant kinematic --arms trained,untrained,constant
#
# The city is the Austin scene package on cvcpkg.org. The host downloads it once (later runs read
# its cache), unpacks it into the state tree and decodes it: the terrain with its aerial image, and
# the buildings. The city node draws that, and the demo reads the same objects for its terrain,
# occupancy and SDF (grl_snam.ariadne._host.document_city), so the bundle is never read twice.
# live.py's --uri / --bundle (or GRL_SNAM_SCENE_BUNDLE) points data.city at another city instead.

meta:
  name: GRL-SNAM live demo
  min_libcvc: 3.7.11

import: [cvc://cars_panels.ari, stats_panels.ari]

requires:
  - {name: chart, optional: true}   # the arms' charts (libcvc 3.7.14)

data:
  city:
    uri: cvcpkg://cy-pca/scene-austin-south-small
    path: share/cvc-scenes/austin_south
    as: city_bundle
    load: lazy

init: |
  (begin
    (state-set "view.paused" "0")
    (state-set "view.speed" "1.0")
    (state-set "view.camera" "follow")
    (state-set "view.car" "0")
    (state-set "view.raster_m" "80")
    (state-set "show.plans" "1")
    (state-set "nav_plant.vehicle" "torch")
    (state-set "run.world" "data")
    (state-set "run.uri" "cvcpkg://cy-pca/scene-austin-south-small")
    (state-set "run.data_path" "share/cvc-scenes/austin_south")
    (state-set "run.crop" "600")
    (state-set "world.seed" "7")
    (state-set "world.half" "500")
    (state-set "world.amp" "25")
    (state-set "world.water_level" "-4")
    (state-set "world.buildings" "160")
    (state-set "world.trees" "200")
    (state-set "world.rocks" "40")
    (state-set "world.terrain" "fbm")
    (state-set "world.city" "districts")
    (state-set "arms.on" "0")
    (state-set "arms.goal" "")
    (state-set "ledger.book" "dU"))

menubar:
  - menu: Demo
    items:
      - menu_item: Paused
        bind: view.paused
      - menu_item: Retarget every arm
        on: arms_retarget
        visible_when: (= (state-get "arms.on") "1")
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Navigator
    id: hud
    pos: [16, 30]
    size: [340, 560]
    children:
      - text: ""
        bind: demo.title
      - separator
      - type: group
        repeat: (state-get "hud.hud")
        children:
          - text: ""
            bind: hud.hud.{i}
      - separator
      - progress: Progress
        bind: hud.progress
        lo: 0
        hi: 1
      - plot: Clearance (m)
        bind: series.clearance
        height: 44
      - plot: Speed (m/s)
        bind: series.speed
        height: 44
      - include: cars_coefficients

  - window: View
    id: view
    pos: [16, 602]
    size: [340, 290]
    children:
      - text: "the plant and the world: austin-freedrive takes any (restart to change them)"
      - combo: Plant
        bind: nav_plant.vehicle
        options: [The demo's own (torch), Kinematic bicycle, Humvee (Jolt), RoboRacer (Jolt), Dynamic Humvee]
        values: [torch, kinematic, humvee, roboracer, "dynamic:humvee"]
        tooltip: "on a plant, libcvc's navigator drives with GRL-SNAM's policy; between plants it switches at once"
      - text: "world"
        bind: run.world
      - checkbox: Paused
        bind: view.paused
      - slider_float: Sim speed
        bind: view.speed
        lo: 0.1
        hi: 4.0
        fmt: "%.1fx"
      - combo: Camera
        bind: view.camera
        options: [Follow the vehicle, Orbit]
        values: [follow, orbit]
      - checkbox: Predicted path
        bind: show.plans

  - include: cars_settings
    pos: [368, 30]
    size: [360, 330]

  - include: cars_world
    pos: [368, 372]
    size: [340, 330]

  - include: cars_rasters
    args: { cost: "the wall barrier's reach (on a plant: the belief)" }
    pos: [740, 30]
    size: [420, 300]

  - include: arms_stats
    pos: [1172, 30]
    size: [600, 400]

  - include: arms_ledger
    pos: [1172, 442]
    size: [600, 540]

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 60, max_radius: 600, per_distance: 3, lead: 0.5,
             lift: 20, ground: city }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 900 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
  nodes:
    - node: city
      source: { data: city }     # the terrain (aerial image draped) and the buildings, when loaded
      visible: { bind: view.city, default: true }
    - node: gen                  # World: Generated (austin-freedrive): libcvc's generator
      type: generated_world
      look: soft
      visible: { bind: view.generated, default: false }
