# live.ari — GRL-SNAM's live demos (grl_snam.demos) in an Ariadne document. grl_snam/ariadne/live.py
# runs the demo and writes the readouts; this document is the window around it:
#
#   python -m grl_snam.ariadne live austin-freedrive
#
# - HUD: the navigator's live NavMetrics (the network's alpha / beta / gamma, clearance, mode,
#   speed, progress), as nav.*, and the HUD's lines at nav.hud;
# - View: pause, the sim speed, and the camera (follow the vehicle, or orbit freely);
# - the scene: the city this document names (data: below), the demo's vehicle, under a soft
#   afternoon light (pale sky, low warm sun, cool fill, soft-edged shadows that follow the camera).
#
# The city is the Austin scene package on cvcpkg.org. The host downloads it once (later runs read
# its cache), unpacks it into the state tree and decodes it: the terrain with its aerial image, and
# the buildings. The city node draws that, and the demo reads the same objects for its terrain,
# occupancy and SDF (grl_snam.ariadne._host.document_city), so the bundle is never read twice.
# live.py's --bundle (or GRL_SNAM_SCENE_BUNDLE) points data.city at a local bundle instead.

meta:
  name: GRL-SNAM live demo
  min_libcvc: 3.4.0

data:
  city:
    uri: cvcpkg://cy-pca/scene-austin-south-small
    path: share/cvc-scenes/austin_south
    as: city_bundle

init: |
  (begin
    (state-set "view.paused" "0")
    (state-set "view.speed" "1.0")
    (state-set "view.camera" "follow"))

menubar:
  - menu: Demo
    items:
      - menu_item: Paused
        bind: view.paused
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Navigator
    id: hud
    pos: [16, 30]
    size: [330, 300]
    children:
      - text: ""
        bind: demo.title
      - separator
      - type: group
        repeat: (state-get "nav.hud")
        children:
          - text: ""
            bind: nav.hud.{i}
      - separator
      - progress: Progress
        bind: nav.progress
        lo: 0
        hi: 1
      - plot: Clearance (m)
        bind: series.clearance
        height: 50
      - plot: Speed (m/s)
        bind: series.speed
        height: 50

  - window: View
    id: view
    pos: [16, 342]
    size: [330, 130]
    children:
      - checkbox: Paused
        bind: view.paused
      - slider_float: Sim speed
        bind: view.speed
        lo: 0.1
        hi: 4.0
        fmt: "%.1fx"
      - combo: Camera
        bind: view.camera
        options: [Follow the vehicle, Orbit]
        values: [follow, orbit]

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 60, max_radius: 600, per_distance: 3, lead: 0.5,
             lift: 20, ground: city }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 900 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
  nodes:
    - node: city
      source: { data: city }     # the terrain (aerial image draped) and the buildings, when loaded
